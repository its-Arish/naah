{
 "title": "Canaan",
 "sections": [
  {
   "title": "Canaan",
   "card": false,
   "beats": [
    {
     "id": "c022",
     "shot": "a22",
     "type": "HOST",
     "text": "Start with a man named Abraham.",
     "date": null
    },
    {
     "id": "c023",
     "shot": "a23",
     "type": "INSERT",
     "text": "According to the Bible,",
     "date": null
    },
    {
     "id": "c024",
     "shot": "a24",
     "type": "INSERT",
     "text": "he leaves his home in Mesopotamia",
     "date": null
    },
    {
     "id": "c025",
     "shot": "a25",
     "type": "INSERT",
     "text": "and walks west into Canaan.",
     "date": null
    },
    {
     "id": "c026",
     "shot": "a26",
     "type": "INSERT",
     "text": "The land between the Mediterranean Sea and the Jordan River.",
     "date": null
    },
    {
     "id": "c027",
     "shot": "a27",
     "type": "INSERT",
     "text": "His grandson Jacob is renamed Israel,",
     "date": null
    },
    {
     "id": "c028",
     "shot": "a28",
     "type": "INSERT",
     "text": "which means something like he who struggles with God.",
     "date": null
    },
    {
     "id": "c029",
     "shot": "a29",
     "type": "INSERT",
     "text": "Jacob's twelve sons become the twelve tribes.",
     "date": null
    },
    {
     "id": "c030",
     "shot": "a30",
     "type": "INSERT",
     "text": "Famine drives the family to Egypt",
     "date": null
    },
    {
     "id": "c031",
     "shot": "a31",
     "type": "INSERT",
     "text": "and the story says they are enslaved there",
     "date": null
    },
    {
     "id": "c032",
     "shot": "a32",
     "type": "INSERT",
     "text": "until a leader named Moses brings them out",
     "date": null
    },
    {
     "id": "c033",
     "shot": "a33",
     "type": "INSERT",
     "text": "and at Mount Sinai they receive the law.",
     "date": null
    },
    {
     "id": "c034",
     "shot": "a34",
     "type": "HOST",
     "text": "Historians can't confirm that story.",
     "date": null
    },
    {
     "id": "c035",
     "shot": "a35",
     "type": "INSERT",
     "text": "There is no Egyptian record of an Exodus,",
     "date": null
    },
    {
     "id": "c036",
     "shot": "a36",
     "type": "INSERT",
     "text": "but there is one very old clue.",
     "date": null
    },
    {
     "id": "c037",
     "shot": "a37",
     "type": "INSERT",
     "text": "Around 1208 BCE,",
     "date": null
    },
    {
     "id": "c038",
     "shot": "a38",
     "type": "INSERT",
     "text": "the Egyptian pharaoh Merneptah carved a victory stone",
     "date": null
    },
    {
     "id": "c039",
     "shot": "a39",
     "type": "INSERT",
     "text": "listing the peoples he had crushed in Canaan.",
     "date": null
    },
    {
     "id": "c040",
     "shot": "a40",
     "type": "INSERT",
     "text": "One of them is called Israel.",
     "date": null
    },
    {
     "id": "c041",
     "shot": "a41",
     "type": "INSERT",
     "text": "It's the oldest known mention of the name outside the Bible.",
     "date": null
    },
    {
     "id": "c042",
     "shot": "a42",
     "type": "INSERT",
     "text": "So about 3,200 years ago,",
     "date": null
    },
    {
     "id": "c043",
     "shot": "a43",
     "type": "INSERT",
     "text": "someone called Israel was already living in those hills.",
     "date": null
    }
   ]
  }
 ]
}