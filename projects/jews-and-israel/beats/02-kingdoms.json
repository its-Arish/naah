{
 "title": "Kingdoms",
 "sections": [
  {
   "title": "Kingdoms",
   "card": false,
   "beats": [
    {
     "id": "c044",
     "shot": "a44",
     "type": "INSERT",
     "text": "By around 1,000 BCE,",
     "date": null
    },
    {
     "id": "c045",
     "shot": "a45",
     "type": "INSERT",
     "text": "the Bible says the tribes unite under kings.",
     "date": null
    },
    {
     "id": "c046",
     "shot": "a46",
     "type": "INSERT",
     "text": "First Saul, then David,",
     "date": null
    },
    {
     "id": "c047",
     "shot": "a47",
     "type": "INSERT",
     "text": "who captures a hill town called Jerusalem",
     "date": null
    },
    {
     "id": "c048",
     "shot": "a48",
     "type": "INSERT",
     "text": "and makes it his capital.",
     "date": null
    },
    {
     "id": "c049",
     "shot": "a49",
     "type": "INSERT",
     "text": "His son Solomon builds a great temple there,",
     "date": null
    },
    {
     "id": "c050",
     "shot": "a50",
     "type": "INSERT",
     "text": "the first temple.",
     "date": null
    },
    {
     "id": "c051",
     "shot": "a51",
     "type": "HOST",
     "text": "How big was this kingdom really?",
     "date": null
    },
    {
     "id": "c052",
     "shot": "a52",
     "type": "INSERT",
     "text": "Archaeologists argue about it.",
     "date": null
    },
    {
     "id": "c053",
     "shot": "a53",
     "type": "INSERT",
     "text": "Some see an empire.",
     "date": null
    },
    {
     "id": "c054",
     "shot": "a54",
     "type": "INSERT",
     "text": "Others see a small highland kingdom.",
     "date": null
    },
    {
     "id": "c055",
     "shot": "a55",
     "type": "INSERT",
     "text": "What nobody argues about is what the temple did.",
     "date": null
    },
    {
     "id": "c056",
     "shot": "a56",
     "type": "INSERT",
     "text": "It made Jerusalem the center of Jewish life for good.",
     "date": null
    },
    {
     "id": "c057",
     "shot": "a57",
     "type": "INSERT",
     "text": "After Solomon, the kingdom splits in two.",
     "date": null
    },
    {
     "id": "c058",
     "shot": "a58",
     "type": "INSERT",
     "text": "Israel in the north, Judah in the south with Jerusalem.",
     "date": null
    },
    {
     "id": "c059",
     "shot": "a59",
     "type": "INSERT",
     "text": "In these years, prophets like Amos and Isaiah appear,",
     "date": null
    },
    {
     "id": "c060",
     "shot": "a60",
     "type": "INSERT",
     "text": "denouncing kings who ignore the poor",
     "date": null
    },
    {
     "id": "c061",
     "shot": "a61",
     "type": "INSERT",
     "text": "and demanding justice from the powerful.",
     "date": null
    },
    {
     "id": "c062",
     "shot": "a62",
     "type": "INSERT",
     "text": "Those demands become some of the most quoted words in the Bible,",
     "date": null
    },
    {
     "id": "c063",
     "shot": "a63",
     "type": "INSERT",
     "text": "but the neighborhood gets dangerous.",
     "date": null
    }
   ]
  }
 ]
}