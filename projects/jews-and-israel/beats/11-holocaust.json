{
 "title": "Holocaust",
 "sections": [
  {
   "title": "Holocaust",
   "card": false,
   "beats": [
    {
     "id": "c293",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "What happens next is the darkest chapter in Jewish history",
     "date": null,
     "quiet": true
    },
    {
     "id": "c294",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "and it should be told plainly.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c295",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "In 1933, the Nazis take power in Germany.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c296",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Step by step, Jews are stripped of citizenship, jobs and homes.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c297",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "In November 1938, on Kristallnacht,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c298",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Synagogues burn across Germany.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c299",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Then comes war and in 1941,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c300",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "mass shootings behind the German lines in the east.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c301",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "By 1942, the Nazis are running death camps",
     "date": null,
     "quiet": true
    },
    {
     "id": "c302",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "with gas chambers built to murder Jews on an industrial scale.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c303",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Six million Jewish men, women and children were killed.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c304",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "About two out of every three Jews in Europe,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c305",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "whole communities in Poland, Lithuania, Greece, Hungary,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c306",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "simply gone.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c307",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Some resist in the Warsaw ghetto uprising in 1943",
     "date": null,
     "quiet": true
    },
    {
     "id": "c308",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "and in the forest as partisans.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c309",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Some neighbors hide Jews at the risk of their own lives.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c310",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "But most countries, including the United States and Britain,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c311",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "keep their doors mostly closed to refugees.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c312",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "The Nazis murder millions of others too.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c313",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Roma, Poles, Soviet prisoners, disabled people.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c314",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "When the camps are liberated in 1945,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c315",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "survivors have nowhere to go.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c316",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Their villages are empty or hostile.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c317",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "About a quarter of a million Jews",
     "date": null,
     "quiet": true
    },
    {
     "id": "c318",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "wait in displaced persons camps, sometimes for years.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c319",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Some try to reach Palestine on crowded,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c320",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "rickety ships past a British naval blockade.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c321",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "In 1947, the ship Exodus, carrying over 4,000 survivors,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c322",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "is intercepted and the passengers are sent back to Germany.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c323",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "The world sees it and for many people,",
     "date": null,
     "quiet": true
    },
    {
     "id": "c324",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "a question that had been political becomes a moral one.",
     "date": null,
     "quiet": true
    },
    {
     "id": "c325",
     "shot": "g_holocaust",
     "type": "HOST",
     "text": "Where exactly are these people supposed to go?",
     "date": null,
     "quiet": true
    }
   ]
  }
 ]
}