{
 "title": "Rome",
 "sections": [
  {
   "title": "Rome",
   "card": false,
   "beats": [
    {
     "id": "c101",
     "shot": "g101",
     "type": "INSERT",
     "text": "Then Rome arrives.",
     "date": null
    },
    {
     "id": "c102",
     "shot": "g102",
     "type": "INSERT",
     "text": "In 63 BCE, the general Pompey marches into Jerusalem.",
     "date": null
    },
    {
     "id": "c103",
     "shot": "g103",
     "type": "INSERT",
     "text": "Rome backs a king named Herod,",
     "date": null
    },
    {
     "id": "c104",
     "shot": "g104",
     "type": "INSERT",
     "text": "who rebuilds the temple on a spectacular scale.",
     "date": null
    },
    {
     "id": "c105",
     "shot": "g105",
     "type": "INSERT",
     "text": "The huge stones of its retaining wall still stand today.",
     "date": null
    },
    {
     "id": "c106",
     "shot": "g106",
     "type": "INSERT",
     "text": "It's the Western wall.",
     "date": null
    },
    {
     "id": "c107",
     "shot": "g107",
     "type": "INSERT",
     "text": "Under Rome, Judea simmers, taxes, rebels, rival sects.",
     "date": null
    },
    {
     "id": "c108",
     "shot": "g108",
     "type": "INSERT",
     "text": "One of them gathers around a Jewish teacher",
     "date": null
    },
    {
     "id": "c109",
     "shot": "g109",
     "type": "INSERT",
     "text": "from Galilee named Jesus,",
     "date": null
    },
    {
     "id": "c110",
     "shot": "g110",
     "type": "INSERT",
     "text": "who is executed by Roman authority around the year 30.",
     "date": null
    },
    {
     "id": "c111",
     "shot": "g111",
     "type": "INSERT",
     "text": "His followers start a movement",
     "date": null
    },
    {
     "id": "c112",
     "shot": "g112",
     "type": "INSERT",
     "text": "that will much later become Christianity.",
     "date": null
    },
    {
     "id": "c113",
     "shot": "g113",
     "type": "INSERT",
     "text": "In 66 CE, the Jews rise up against Rome.",
     "date": null
    },
    {
     "id": "c114",
     "shot": "g114",
     "type": "INSERT",
     "text": "It is a catastrophe.",
     "date": null
    },
    {
     "id": "c115",
     "shot": "g115",
     "type": "INSERT",
     "text": "In 70, the Roman general Titus besieges Jerusalem",
     "date": null
    },
    {
     "id": "c116",
     "shot": "g116",
     "type": "INSERT",
     "text": "and burns the second temple.",
     "date": null
    },
    {
     "id": "c117",
     "shot": "g117",
     "type": "INSERT",
     "text": "Hundreds of thousands die.",
     "date": null
    },
    {
     "id": "c118",
     "shot": "g118",
     "type": "INSERT",
     "text": "The arch of Titus in Rome, still standing,",
     "date": null
    },
    {
     "id": "c119",
     "shot": "g119",
     "type": "INSERT",
     "text": "shows soldiers carrying off the temple's golden menorah.",
     "date": null
    },
    {
     "id": "c120",
     "shot": "g120",
     "type": "INSERT",
     "text": "The last rebels hold out in the desert fortress of Masada",
     "date": null
    },
    {
     "id": "c121",
     "shot": "g121",
     "type": "INSERT",
     "text": "until about 73.",
     "date": null
    }
   ]
  }
 ]
}