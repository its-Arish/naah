{
 "title": "Exile",
 "sections": [
  {
   "title": "Exile",
   "card": false,
   "beats": [
    {
     "id": "c064",
     "shot": "g64",
     "type": "INSERT",
     "text": "In 722 BCE, the Assyrian Empire crushes the northern kingdom",
     "date": null
    },
    {
     "id": "c065",
     "shot": "g65",
     "type": "INSERT",
     "text": "and scatters its people.",
     "date": null
    },
    {
     "id": "c066",
     "shot": "g66",
     "type": "INSERT",
     "text": "They vanish from history, the 10 lost tribes,",
     "date": null
    },
    {
     "id": "c067",
     "shot": "g67",
     "type": "INSERT",
     "text": "Judah survives, barely. Then comes Babylon.",
     "date": null
    },
    {
     "id": "c068",
     "shot": "g68",
     "type": "INSERT",
     "text": "In 586 BCE, King Nebuchadnezzar burns Jerusalem,",
     "date": null
    },
    {
     "id": "c069",
     "shot": "g69",
     "type": "INSERT",
     "text": "destroys Solomon's temple",
     "date": null
    },
    {
     "id": "c070",
     "shot": "g70",
     "type": "INSERT",
     "text": "and marches Judah's leaders almost 1,000 miles east in chains.",
     "date": null
    },
    {
     "id": "c071",
     "shot": "g71",
     "type": "INSERT",
     "text": "That is the first exile.",
     "date": null
    },
    {
     "id": "c072",
     "shot": "g72",
     "type": "HOST",
     "text": "And it changes everything.",
     "date": null
    },
    {
     "id": "c073",
     "shot": "g73",
     "type": "HOST",
     "text": "Here's the question exile forces.",
     "date": null
    },
    {
     "id": "c074",
     "shot": "g74",
     "type": "INSERT",
     "text": "If your god lives in one temple in one city",
     "date": null
    },
    {
     "id": "c075",
     "shot": "g75",
     "type": "INSERT",
     "text": "and the temple is rubble and you're 1,000 miles away,",
     "date": null
    },
    {
     "id": "c076",
     "shot": "g76",
     "type": "HOST",
     "text": "what are you?",
     "date": null
    },
    {
     "id": "c077",
     "shot": "g77",
     "type": "INSERT",
     "text": "The exiles in Babylon answer by inventing something new.",
     "date": null
    },
    {
     "id": "c078",
     "shot": "g78",
     "type": "INSERT",
     "text": "They gather.",
     "date": null
    },
    {
     "id": "c079",
     "shot": "g79",
     "type": "INSERT",
     "text": "They write down their stories.",
     "date": null
    },
    {
     "id": "c080",
     "shot": "g80",
     "type": "INSERT",
     "text": "They pray together without any temple at all.",
     "date": null
    },
    {
     "id": "c081",
     "shot": "g81",
     "type": "INSERT",
     "text": "A people held together by a book and a calendar,",
     "date": null
    },
    {
     "id": "c082",
     "shot": "g82",
     "type": "INSERT",
     "text": "instead of a building.",
     "date": null
    },
    {
     "id": "c083",
     "shot": "g83",
     "type": "HOST",
     "text": "Remember that.",
     "date": null
    },
    {
     "id": "c084",
     "shot": "g84",
     "type": "HOST",
     "text": "It's the trick that will save them again and again.",
     "date": null
    }
   ]
  }
 ]
}