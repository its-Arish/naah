       "boing",
       38,
       0.4
      ]
     ]
    },
    {
     "id": "s07b03",
     "shot": "coronation",
     "type": "STORY",
     "text": "and in 1804 he crowned himself emperor, literally taking the crown from the pope's hands.",
     "date": 1804,
     "sfx": [
      [
       "whoosh",
       "w:taking",
       0.5
      ],
      [
       "ding",
       "w:pope's",
       0.5
      ]
     ],
     "mood": "grand"
    },
    {
     "id": "s07b04",
     "shot": "full_circle",
     "type": "INSERT",
     "text": "A revolution that began by beheading a king had ended with an emperor.",
