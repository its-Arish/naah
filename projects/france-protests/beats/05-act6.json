     "sfx": [
      [
       "stamp",
       "w:prefects.",
       0.5
      ]
     ]
    },
    {
     "id": "s07b10",
     "shot": "prefects",
     "type": "INSERT",
     "text": "They come back.",
     "date": 1800,
     "sfx": []
    },
    {
     "id": "s07b11",
     "shot": "height",
     "type": "INSERT",
     "text": "And the legend that he was tiny?",
