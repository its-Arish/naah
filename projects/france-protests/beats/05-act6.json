     "sfx": [
      [
       "hit",
       "w:king",
       0.4
      ],
      [
       "sparkle",
       "w:emperor.",
       0.5
      ]
     ]
    },
    {
     "id": "s07b05",
     "shot": "civil_code",
     "type": "INSERT",
     "text": "But he also built things that are still here.",
     "date": 1804,
     "sfx": [
      [
       "pops",
       6,
       0.4
      ]
     ]
    },
    {
     "id": "s07b06",
     "shot": "civil_code",
     "type": "INSERT",
     "text": "The Civil Code of 1804 is still the foundation of French law.",
     "date": 1804,
     "sfx": [
      [
       "thud",
       14,
       0.8
      ]
     ]
    },
    {
     "id": "s07b07",
     "shot": "prefects",
     "type": "INSERT",
     "text": "And in 1800 he created the prefects, officials who run each region on behalf",
     "date": 1800,
     "sfx": [
      [
       "pops",
       "w:prefects,",
       0.4
      ]
     ]
    },
    {
     "id": "s07b08",
     "shot": "prefects",
     "type": "INSERT",
     "text": "of the central government in Paris.",
     "date": 1800,
     "sfx": []
    },
    {
     "id": "s07b09",
     "shot": "prefects",
     "type": "INSERT",
     "text": "Remember the prefects.",
