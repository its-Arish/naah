     "sfx": [
      [
       "stamp",
       "w:Third",
       0.5
      ]
     ]
    },
    {
     "id": "s07b29",
     "shot": "siege",
     "type": "INSERT",
     "text": "Paris was besieged for four months, and its starving citizens ate the zoo, including the elephants.",
     "date": 1870,
     "sfx": [
      [
       "drum",
       4,
       0.4
      ],
      [
