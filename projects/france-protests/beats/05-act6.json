       "w:coup",
       0.7
      ],
      [
       "sparkle",
       "w:Emperor",
       0.4
      ]
     ]
    },
    {
     "id": "s07b24",
     "shot": "boulevards",
     "type": "INSERT",
     "text": "He rebuilt Paris with wide boulevards, partly, many historians say,",
     "date": 1860,
     "sfx": [
      [
       "slide",
       6,
       0.3
      ]
     ]
    },
    {
     "id": "s07b25",
     "shot": "boulevards",
     "type": "INSERT",
     "text": "to make barricades harder to build and troops easier to move.",
     "date": 1860,
     "sfx": [
      [
       "steps",
       0,
       0.3
      ]
     ]
    },
    {
     "id": "s07b26",
     "shot": "didnt_save",
