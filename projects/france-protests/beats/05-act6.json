       0.5
      ]
     ],
     "mood": "playful"
    },
    {
     "id": "s07b18",
     "shot": "july1830",
     "type": "STORY",
     "text": "In July 1830, three days of street fighting toppled Charles X,",
     "date": 1830,
     "sfx": [
      [
       "drum",
       "w:fighting",
       0.5
      ]
     ]
    },
    {
     "id": "s07b19",
     "shot": "july1830",
     "type": "STORY",
     "text": "who had tried to muzzle the press.",
     "date": 1830,
     "sfx": [
      [
       "stamp",
       "w:muzzle",
       0.6
      ]
     ]
    },
    {
     "id": "s07b20",
     "shot": "mr_smith",
     "type": "STORY",
     "text": "In 1848 it happened again, and the new king,",
     "date": 1848,
     "sfx": [
      [
       "steps",
       4,
       0.3
      ]
     ],
     "mood": "playful"
    },
    {
     "id": "s07b21",
     "shot": "mr_smith",
     "type": "STORY",
     "text": "Louis-Philippe, fled to England under the name 'Mr Smith.' The Second Republic elected Napoleon's nephew as president.",
     "date": 1848,
     "sfx": [
      [
       "pop2",
       "w:Smith.",
       0.5
      ],
      [
       "kaching",
       "w:elected",
       0.4
      ]
     ],
     "mood": "playful"
    },
    {
     "id": "s07b22",
     "shot": "nap3",
     "type": "INSERT",
     "text": "The constitution barred him from a second term,",
     "date": 1851,
     "sfx": []
    },
    {
     "id": "s07b23",
     "shot": "nap3",
     "type": "INSERT",
     "text": "so in 1851 he took power in a coup and became Emperor Napoleon III.",
