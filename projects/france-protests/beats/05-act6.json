    },
    {
     "id": "s07b16",
     "shot": "schedule",
     "type": "HOST",
     "text": "Then France did something remarkable.",
     "date": null,
     "sfx": []
    },
    {
     "id": "s07b17",
     "shot": "schedule",
     "type": "HOST",
     "text": "It started overthrowing them on a schedule.",
