       0.5
      ]
     ]
    },
    {
     "id": "s07b12",
     "shot": "height",
     "type": "INSERT",
     "text": "He was about five foot six or seven, normal for his time.",
     "date": null,
     "sfx": [
      [
       "ding",
       "w:five",
       0.4
      ]
     ]
    },
    {
     "id": "s07b13",
     "shot": "height",
     "type": "INSERT",
     "text": "The myth comes from French and English inches being different lengths,",
