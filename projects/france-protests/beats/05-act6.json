     "date": 1803,
     "sfx": [
      [
       "paper",
       2,
       0.4
      ]
     ],
     "mood": "playful"
    },
    {
     "id": "s07b15",
     "shot": "waterloo",
     "type": "STORY",
     "text": "He lost at Waterloo on 18 June 1815, and the Bourbon kings came back.",
