{
 "sections": [
  {
   "title": "Act 6: The Emperor, the Flight and the Flames",
   "beats": [
    {
     "id": "s07b01",
     "shot": "napoleon_host",
     "type": "HOST",
     "text": "His name was Napoleon Bonaparte.",
