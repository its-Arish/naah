     "sfx": [
      [
       "paper",
       "w:rewrote",
       0.5
      ]
     ]
    },
    {
     "id": "s08b14",
     "shot": "fifth_republic",
     "type": "INSERT",
     "text": "The Fifth Republic, the one France still has,",
     "date": 1958,
     "sfx": [
      [
       "thud",
