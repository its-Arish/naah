       0.5
      ]
     ]
    },
    {
     "id": "s08b15",
     "shot": "fifth_republic",
     "type": "INSERT",
     "text": "gave the president enormous power, and from 1962 the president was elected directly by the people.",
     "date": 1962,
     "sfx": [
