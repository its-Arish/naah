       "w:Incorruptible.",
       0.6
      ]
     ]
    },
    {
     "id": "s05b32",
     "shot": "death_count",
     "type": "INSERT",
     "text": "The government he dominated would sentence around seventeen thousand people to death in ten months.",
     "date": 1794,
