       "ding",
       "w:October.",
       0.4
      ]
     ]
    },
    {
     "id": "s11b49",
     "shot": "split",
     "type": "HOST",
     "text": "So what's driving it?",
     "date": null,
     "sfx": []
    },
    {
     "id": "s11b50",
     "shot": "split",
